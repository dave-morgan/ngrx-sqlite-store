{
  "name": "ngrx-sqlite-store",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:lib": "ng test ngrx-sqlite-store --watch=false",
    "spikes": "node projects/ngrx-sqlite-store/spikes/run.mjs",
    "test:harness": "ng test harness --watch=false",
    "build:lib": "ng build ngrx-sqlite-store",
    "harness:classic": "ng serve harness -c classic --port 4301",
    "harness:sqlite": "ng serve harness -c sqlite --port 4302",
    "e2e": "playwright test",
    "e2e:classic": "cross-env E2E_IMPL=classic playwright test --project=classic",
    "e2e:sqlite": "cross-env E2E_IMPL=sqlite playwright test --project=sqlite",
    "android:classic": "ng build harness -c production,classic && cap sync android",
    "android:sqlite": "ng build harness -c production,sqlite && cap sync android",
    "android:run": "cap run android"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/core": "^8.5.3",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/entity": "^22.0.1",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/router-store": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "jeep-sqlite": "^2.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/sql.js": "^1.4.11",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "sql.js": "^1.15.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
