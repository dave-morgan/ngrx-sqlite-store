{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ngrx-sqlite-store": {
      "projectType": "library",
      "root": "projects/ngrx-sqlite-store",
      "sourceRoot": "projects/ngrx-sqlite-store/src",
      "prefix": "nss",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ngrx-sqlite-store/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngrx-sqlite-store/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngrx-sqlite-store/tsconfig.spec.json"
          }
        }
      }
    },
    "harness": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/harness",
      "sourceRoot": "projects/harness/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/harness/src/main.ts",
            "tsConfig": "projects/harness/tsconfig.app.classic.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/harness/public"
              },
              {
                "glob": "sql-wasm.wasm",
                "input": "node_modules/sql.js/dist",
                "output": "assets"
              }
            ],
            "styles": [
              "projects/harness/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "classic": {
              "tsConfig": "projects/harness/tsconfig.app.classic.json"
            },
            "sqlite": {
              "tsConfig": "projects/harness/tsconfig.app.sqlite.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "harness:build:production"
            },
            "development": {
              "buildTarget": "harness:build:development"
            },
            "classic": {
              "buildTarget": "harness:build:development,classic"
            },
            "sqlite": {
              "buildTarget": "harness:build:development,sqlite"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/harness/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
