  "sql": "SELECT slot, payload FROM (\n              WITH counts AS MATERIALIZED (\n                SELECT COUNT(CASE WHEN ((((COALESCE(json_type(data, '$.done') IN ('true','false'), 0) AND json_extract(data, '$.done') IS ?)))) THEN 1 END) AS c0,COUNT(CASE WHEN (1) THEN 1 END) AS c1 FROM nss_entity\n                WHERE coll = ? AND data != '' AND json_valid(data)\n              ), promoted AS MATERIALIZED (\n                SELECT id FROM nss_entity WHERE coll = ? AND data = ''\n              ) SELECT 0 AS slot,\n                CASE WHEN length(CAST(payload AS BLOB)) <= 1048576 THEN payload END AS payload\n                FROM (SELECT json_group_array(json_object('id',id,'value',value)) AS payload\n                  FROM (SELECT id,NULL AS value FROM promoted UNION ALL SELECT NULL,c0 FROM counts)) UNION ALL SELECT 1 AS slot,\n                CASE WHEN length(CAST(payload AS BLOB)) <= 1048576 THEN payload END AS payload\n                FROM (SELECT json_group_array(json_object('id',id,'value',value)) AS payload\n                  FROM (SELECT id,NULL AS value FROM promoted UNION ALL SELECT NULL,c1 FROM counts))\n            )",
